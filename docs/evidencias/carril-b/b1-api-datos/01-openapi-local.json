{
    "openapi": "3.1.0",
    "info": {
        "title": "Data API - Proyecto Final MLOps",
        "version": "v2"
    },
    "paths": {
        "/metrics": {
            "get": {
                "summary": "Metrics",
                "description": "Endpoint that serves Prometheus metrics.",
                "operationId": "metrics_metrics_get",
                "responses": {
                    "200": {
                        "description": "Successful Response",
                        "content": {
                            "application/json": {
                                "schema": {}
                            }
                        }
                    }
                }
            }
        },
        "/health": {
            "get": {
                "tags": [
                    "healthcheck"
                ],
                "summary": "Get Health",
                "operationId": "get_health_health_get",
                "responses": {
                    "200": {
                        "description": "Successful Response",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/HealthCheck"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/": {
            "get": {
                "summary": "Root",
                "operationId": "root__get",
                "responses": {
                    "200": {
                        "description": "Successful Response",
                        "content": {
                            "application/json": {
                                "schema": {}
                            }
                        }
                    }
                }
            }
        },
        "/data": {
            "get": {
                "summary": "Read Data",
                "operationId": "read_data_data_get",
                "parameters": [
                    {
                        "name": "group_number",
                        "in": "query",
                        "required": true,
                        "schema": {
                            "type": "integer",
                            "title": "Group Number"
                        }
                    },
                    {
                        "name": "day",
                        "in": "query",
                        "required": false,
                        "schema": {
                            "anyOf": [
                                {
                                    "enum": [
                                        "Tuesday",
                                        "Wednesday"
                                    ],
                                    "type": "string"
                                },
                                {
                                    "type": "null"
                                }
                            ],
                            "description": "D\u00eda de la clase (opcional; compatible con v1)",
                            "title": "Day"
                        },
                        "description": "D\u00eda de la clase (opcional; compatible con v1)"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Successful Response",
                        "content": {
                            "application/json": {
                                "schema": {}
                            }
                        }
                    },
                    "422": {
                        "description": "Validation Error",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/HTTPValidationError"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/restart_data_generation": {
            "get": {
                "summary": "Restart Data",
                "operationId": "restart_data_restart_data_generation_get",
                "parameters": [
                    {
                        "name": "group_number",
                        "in": "query",
                        "required": true,
                        "schema": {
                            "type": "integer",
                            "title": "Group Number"
                        }
                    },
                    {
                        "name": "day",
                        "in": "query",
                        "required": false,
                        "schema": {
                            "anyOf": [
                                {
                                    "enum": [
                                        "Tuesday",
                                        "Wednesday"
                                    ],
                                    "type": "string"
                                },
                                {
                                    "type": "null"
                                }
                            ],
                            "description": "D\u00eda de la clase (opcional; compatible con v1)",
                            "title": "Day"
                        },
                        "description": "D\u00eda de la clase (opcional; compatible con v1)"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Successful Response",
                        "content": {
                            "application/json": {
                                "schema": {}
                            }
                        }
                    },
                    "422": {
                        "description": "Validation Error",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/HTTPValidationError"
                                }
                            }
                        }
                    }
                }
            }
        }
    },
    "components": {
        "schemas": {
            "HTTPValidationError": {
                "properties": {
                    "detail": {
                        "items": {
                            "$ref": "#/components/schemas/ValidationError"
                        },
                        "type": "array",
                        "title": "Detail"
                    }
                },
                "type": "object",
                "title": "HTTPValidationError"
            },
            "HealthCheck": {
                "properties": {
                    "status": {
                        "type": "string",
                        "title": "Status",
                        "default": "OK"
                    }
                },
                "type": "object",
                "title": "HealthCheck"
            },
            "ValidationError": {
                "properties": {
                    "loc": {
                        "items": {
                            "anyOf": [
                                {
                                    "type": "string"
                                },
                                {
                                    "type": "integer"
                                }
                            ]
                        },
                        "type": "array",
                        "title": "Location"
                    },
                    "msg": {
                        "type": "string",
                        "title": "Message"
                    },
                    "type": {
                        "type": "string",
                        "title": "Error Type"
                    },
                    "input": {
                        "title": "Input"
                    },
                    "ctx": {
                        "type": "object",
                        "title": "Context"
                    }
                },
                "type": "object",
                "required": [
                    "loc",
                    "msg",
                    "type"
                ],
                "title": "ValidationError"
            }
        }
    }
}
